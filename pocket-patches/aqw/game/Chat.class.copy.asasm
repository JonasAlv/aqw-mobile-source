     pushstring          "<CannedChat>\r\n\x09<l1 display=\"Emotes\">\r\n\x09\x09<l2 id=\"emote\" display=\"Dance\" text=\"dance\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Dance2\" text=\"dance2\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Laugh\" text=\"laugh\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Cry\" text=\"cry\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Cheer\" text=\"cheer\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Point\" text=\"point\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Use\" text=\"use\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Feign\" text=\"feign\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Sleep\" text=\"sleep\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Jump\" text=\"jump\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Punt\" text=\"punt\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Wave\" text=\"wave\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Bow\" text=\"bow\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Salute\" text=\"Salute\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Backflip\" text=\"backflip\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Swordplay\" text=\"swordplay\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Unsheath\" text=\"unsheath\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Facepalm\" text=\"facepalm\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Air Guitar\" text=\"airguitar\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Stern\" text=\"stern\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Member Emotes\">\r\n\x09\x09<l2 id=\"emote\" display=\"Powerup\" text=\"powerup\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Kneel\" text=\"kneel\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Jumpcheer\" text=\"jumpcheer\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Salute2\" text=\"salute2\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Cry2\" text=\"cry2\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Spar\" text=\"spar\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Stepdance\" text=\"stepdance\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Headbang\" text=\"headbang\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"Dazed\" text=\"dazed\"/>\r\n\x09\x09<l2 id=\"emote\" display=\"DanceWeapon\" text=\"danceweapon\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Greetings\">\r\n\x09\x09<l2 id=\"ba\" display=\"Hello!\" text=\"Hello!\"/>\r\n\x09\x09<l2 id=\"bb\" display=\"Hi!\" text=\"Hi!\"/>\r\n\x09\x09<l2 id=\"bc\" display=\"Well met!\" text=\"Well met!\"/>\r\n\x09\x09<l2 id=\"bd\" display=\"Welcome!\" text=\"Welcome!\"/>\r\n\x09\x09<l2 id=\"be\" display=\"Welcome back!\" text=\"Welcome back!\"/>\r\n\x09\x09<l2 id=\"bf\" display=\"How are you today?\" text=\"How are you today?\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Farewells\">\r\n\x09\x09<l2 id=\"ca\" display=\"Bye!\" text=\"Bye!\"/>\r\n\x09\x09<l2 id=\"cb\" display=\"See you later.\" text=\"See you later.\"/>\r\n\x09\x09<l2 id=\"cc\" display=\"AFK\" text=\"I'm going AFK\"/>\r\n\x09\x09<l2 id=\"cd\" display=\"I have to go now.\" text=\"I have to go now.\"/>\r\n\x09\x09<l2 id=\"ce\" display=\"Logging out now\" text=\"Logging out now.\"/>\r\n\x09\x09<l2 id=\"cf\" display=\"brb\" text=\"brb\"/>\r\n\x09\x09<l2 id=\"cg\" display=\"Farewell\" text=\"Farewell\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Questions\">\r\n\x09\x09<l2 id=\"da\" display=\"Can I add you\">\r\n\x09\x09\x09<l3 id=\"ea\" display=\"to my Friends list\" text=\"Can I add you to my Friends list?\"/>\r\n\x09\x09\x09<l3 id=\"eb\" display=\"to my Party\" text=\"Can I add you to my Party?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"db\" display=\"Do you want to battle together?\" text=\"Do you want to battle together?\"/>\r\n\x09    <l2 id=\"dc\" display=\"Is that a Member only...\">\r\n\x09\x09\x09<l3 id=\"fa\" display=\"Helm\" text=\" Is that a Member only helm?\"/>\r\n\x09\x09\x09<l3 id=\"fb\" display=\"Cape\" text=\" Is that a Member only cape?\"/>\r\n\x09\x09\x09<l3 id=\"fc\" display=\"Armor\" text=\" Is that a Member only armor?\"/>\r\n\x09\x09\x09<l3 id=\"fd\" display=\"Weapon\" text=\" Is that a Member only weapon?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"dd\" display=\"Where are you?\" text=\"Where are you?\"/>\r\n\x09\x09<l2 id=\"de\" display=\"Are you sure?\" text=\"Are you sure?\"/>\r\n\x09\x09<l2 id=\"df\" display=\"Can I help you?\" text=\"Can I help you?\"/>\r\n\x09\x09<l2 id=\"dg\" display=\"What is your alignment?\" text=\"What is your alignment?\"/>\r\n\x09\x09<l2 id=\"dh\" display=\"Where did you get that ...\">\r\n\x09\x09\x09<l3 id=\"ga\" display=\"Helm\" text=\"Where did you get that helm?\"/>\r\n\x09\x09\x09<l3 id=\"gb\" display=\"Cape\" text=\"Where did you get that cape?\"/>\r\n\x09\x09\x09<l3 id=\"gc\" display=\"Armor\" text=\"Where did you get that armor?\"/>\r\n\x09\x09\x09<l3 id=\"gd\" display=\"Weapon\" text=\"Where did you get that weapon?\"/>\r\n\x09\x09\x09<l3 id=\"ge\" display=\"Pet\" text=\"Where did you get that pet?\"/>\r\n\x09\x09\x09<l3 id=\"ge\" display=\"Class\" text=\"Where did you get that class?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"di\" display=\"Are you a...\">\r\n\x09\x09\x09<l3 id=\"ha\" display=\"Guardian\" text=\"Are you a Guardian?\"/>\r\n\x09\x09\x09<l3 id=\"hb\" display=\"DragonLord\" text=\"Are you a DragonLord?\"/>\r\n\x09\x09\x09<l3 id=\"hc\" display=\"StarCaptain\" text=\"Are you a StarCaptain?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"dj\" display=\"Do you play...\">\r\n\x09\x09\x09<l3 id=\"ia\" display=\"AdventureQuest\" text=\"Do you play AdventureQuest?\"/>\r\n\x09\x09\x09<l3 id=\"ib\" display=\"DragonFable\" text=\"Do you play DragonFable?\"/>\r\n\x09\x09\x09<l3 id=\"ic\" display=\"MechQuest\" text=\"Do you play MechQuest?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"dl\" display=\"What are you doing?\" text=\"What are you doing?\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Answers\">\r\n\x09\x09<l2 id=\"ja\" display=\"thanks/welcome\">\r\n\x09\x09\x09<l3 id=\"ka\" display=\"Thanks!\" text=\"Thanks!\"/>\r\n\x09\x09\x09<l3 id=\"kb\" display=\"Thank you!\" text=\"Thank you!\"/>\r\n\x09\x09\x09<l3 id=\"kc\" display=\"Thanks for helping me.\" text=\"Thanks for helping me.\"/>\r\n\x09\x09\x09<l3 id=\"kd\" display=\"I owe you one.\" text=\"I owe you one..\"/>\r\n\x09\x09\x09<l3 id=\"ke\" display=\"No problem!\" text=\"No problem!\"/>\r\n\x09\x09\x09<l3 id=\"kf\" display=\"You're welcome!\" text=\"You're welcome!\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"jn\" display=\"I am doing/trying to..\">\r\n\x09\x09\x09<l3 id=\"ma\" display=\"Quest\" text=\"I am doing a quest.\"/>\r\n\x09\x09\x09<l3 id=\"mb\" display=\"Farming\" text=\"I am farming.\"/>\r\n\x09\x09\x09<l3 id=\"mc\" display=\"New\" text=\"I am playing the new release.\"/>\r\n\x09\x09\x09<l3 id=\"md\" display=\"Level up.\" text=\"I am trying to level up.\"/>\r\n\x09\x09\x09<l3 id=\"me\" display=\"Rank up.\" text=\"I am trying to rank up.\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"jb\" display=\"I'm fine, thanks.\" text=\"I'm fine, thanks.\"/>\x09\r\n\x09\x09<l2 id=\"jc\" display=\"Could be better.\" text=\"Could be better.\"/>\r\n\x09\x09<l2 id=\"jd\" display=\"I don't think so.\" text=\"I don't think so.\"/>\r\n\x09\x09<l2 id=\"je\" display=\"I don't know.\" text=\"I don't know.\"/>\r\n\x09\x09<l2 id=\"jf\" display=\"Indeed.\" text=\"Indeed.\"/>\r\n\x09\x09<l2 id=\"jg\" display=\"Pleased to meet you.\" text=\"Pleased to meet you.\"/>\r\n\x09\x09<l2 id=\"jh\" display=\"Good.\" text=\"I am Good.\"/>\r\n\x09\x09<l2 id=\"ji\" display=\"Evil.\" text=\"I am Evil.\"/>\r\n\x09\x09<l2 id=\"jj\" display=\"Me too!\" text=\"Me too!\"/>\r\n\x09\x09<l2 id=\"jk\" display=\"I got it...\">\r\n\x09\x09\x09<l3 id=\"la\" display=\"as a drop.\" text=\"I got it as a drop.\"/>\r\n\x09\x09\x09<l3 id=\"lb\" display=\"from a shop.\" text=\"I got it from a shop.\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"jl\" display=\"Check the Wiki...\" text=\"You can check the Wiki for the location.\"/>\r\n\x09\x09<l2 id=\"jm\" display=\"Your Book of Lore will know that\" text=\"Your Book of Lore will know that.\"/>\r\n\x09\x09<l2 id=\"jo\" display=\"I can only use Canned Chat.\" text=\"I can only use Canned Chat.\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"Meeting up\">\r\n\x09\x09<l2 id=\"na\" display=\"Follow me!\" text=\"Follow me!\"/>\r\n\x09\x09<l2 id=\"nb\" display=\"Over here!\" text=\"Over here!\"/>\r\n\x09\x09<l2 id=\"nc\" display=\"Goto me.\" text=\"Goto me.\"/>\r\n\x09\x09<l2 id=\"nd\" display=\"I'll follow you.\" text=\"I'll follow you.\"/>\r\n\x09\x09<l2 id=\"ne\" display=\"Maybe some other time.\" text=\"Maybe some other time.\"/>\r\n\x09\x09<l2 id=\"nf\" display=\"Ok, let's go.\" text=\"Ok, let's go.\"/>\r\n\x09\x09<l2 id=\"ng\" display=\"Come back here.\" text=\"Come back here.\"/>\r\n\x09\x09<l2 id=\"nh\" display=\"I need to finish this first.\" text=\"I need to finish this first.\"/>\r\n\x09\x09<l2 id=\"ni\" display=\"Seriously?\" text=\"Seriously?\"/>\r\n\x09\x09<l2 id=\"nj\" display=\"*I'm going to...\">\r\n\x09\x09\x09<l3 id=\"oa\" display=\"Artix\" text=\"I'm going to the Artix Server.\"/>\r\n\x09\x09\x09<l3 id=\"ob\" display=\"Galanoth\" text=\"I'm going to the Galanoth Server.\"/>\x09\r\n\x09\x09\x09<l3 id=\"oh\" display=\"Sir Ver\" text=\"I'm going to Sir Ver.\"/>\r\n\x09\x09\x09<l3 id=\"oi\" display=\"Twig\" text=\"I'm going to the Twig server.\"/>\r\n\x09\x09\x09<l3 id=\"oj\" display=\"Twilly\" text=\"I'm going to the Twilly server.\"/>\r\n\x09\x09\x09<l3 id=\"ok\" display=\"Yorumi\" text=\"I'm going to the Yorumi server.\"/>\r\n\x09\x09\x09<l3 id=\"oj\" display=\"TestingServer\" text=\"I'm going to the TestingServer server.\"/>\r\n\x09\x09\x09<l3 id=\"ok\" display=\"TestingServer2\" text=\"I'm going to the TestingServer2 server.\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"nk\" display=\"Sorry, I'm busy.\" text=\"Sorry, I'm busy.\"/>\r\n\x09</l1>\r\n\x09<l1 display=\"In Battle\">\r\n\x09\x09<l2 id=\"pa\" display=\"Can you..\">\r\n\x09\x09\x09<l3 id=\"qa\" display=\"help with battle\" text=\"Can you help me with this battle?\"/>\r\n\x09\x09\x09<l3 id=\"qb\" display=\"help with Boss\" text=\"Can you help me with the Boss?\"/>\r\n\x09\x09</l2>\r\n\x09\x09<l2 id=\"pb\" display=\"Planning...\">\r\n\x09\x09\x09<l3 id=\"ra\" display=\"L